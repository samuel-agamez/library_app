yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Variables de entorno locales (la plantilla es .env.example)
.env*
!.env.example

# Cobertura y cachés
coverage/
.eslintcache

# Credenciales móviles / Firebase (la app no debe hablar con Firebase)
*.keystore
