GoogleService-Info.plist

# Artefactos de compilación móvil
*.apk
*.aab
*.ipa

# Firebase CLI (si algún día se usa)
.firebase/
firebase-debug.log*
firestore-debug.log*

# Si algún día despliegas la web
.vercel/

# Sistema y editor (.vscode sí se comparte en este repo)
Thumbs.db
Desktop.ini
.idea/

# Documentos institucionales y archivos temporales de Office/Windows: no se publican
*.docx
.~lock.*#
*:Zone.Identifier
