# Copia este archivo a .env y ajusta la URL de library_api.
# Expo expone al bundle SOLO las variables con prefijo EXPO_PUBLIC_ → nunca pongas secretos aquí.
#
#  - Tu API en Vercel:             https://libraryapi-six.vercel.app
#  - Dispositivo físico (Expo Go): http://IP-DE-TU-PC:3000  (y `npm run dev:lan` en la API)
#  - Emulador Android:             http://10.0.2.2:3000
#  - Simulador iOS / web:          http://localhost:3000
EXPO_PUBLIC_API_URL=https://libraryapi-six.vercel.app
